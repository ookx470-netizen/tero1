{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/badges/(.*)",
      "destination": "/badges/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api/|assets/|badges/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
