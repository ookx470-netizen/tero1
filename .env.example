# TERO Network — copy this file to .env.local (or set these in your hosting
# provider's environment settings) and fill in real values before deploying.
# NONE of these have unsafe hardcoded defaults anymore — see SECURITY.md.

PORT=3000

# --- Session / auth ---------------------------------------------------
# Long random string used to sign login tokens (admin + users).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Admin account (seeded once on first boot, then stored hashed) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Firebase (Admin SDK) ----------------------------------------------
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the ENTIRE downloaded JSON file content as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Telegram bot (optional) -------------------------------------------
# From @BotFather. The old token committed in this repo is compromised —
# rotate it via @BotFather before using Telegram features again.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TeroComunityBot

# --- Polygon / on-chain deposit verification (optional) ----------------
# A Polygon RPC endpoint (e.g. from Alchemy, Infura, QuickNode, or the
# public https://polygon-rpc.com). Without this, deposits are recorded as
# "pending" for manual admin review instead of being auto-verified.
POLYGON_RPC_URL=
# Polygon USDT contract — only change this if you actually mean a
# different token/network.
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8
